# Postgres (docker-compose default)
DATABASE_URL="postgresql://billing:billing@localhost:5433/billing?schema=public"

# Used by tests only (separate database, see docker/init-test-db.sql)
TEST_DATABASE_URL="postgresql://billing:billing@localhost:5433/billing_test?schema=public"

# If this port is already taken on your machine (e.g. Docker Desktop's WSL
# relay can bind :3000 on Windows), just change it here.
PORT=3000

# Stripe TEST MODE keys only. Get these from https://dashboard.stripe.com/test/apikeys
# NEVER put live keys (sk_live_..., whsec_ from a live endpoint) here or anywhere in the repo.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Used to build Stripe Checkout redirect URLs (no frontend required, plain placeholders are fine)
CHECKOUT_SUCCESS_URL="http://localhost:3000/checkout/success"
CHECKOUT_CANCEL_URL="http://localhost:3000/checkout/cancel"
